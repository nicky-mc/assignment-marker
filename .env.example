# Variable names only. Copy to .env.local and fill in. Never commit real values.

# Switches. Defaults keep the app exactly as it was before sign-in and the database existed.
AUTH_MODE=off          # off | on   (production refuses to serve /api/mark unless this is "on")
RUBRIC_SOURCE=file     # file | supabase   (supabase needs AUTH_MODE=on)

REQUIRE_SECOND_APPROVER=false   # true: the admin who created a draft cannot approve it

# Supabase (only needed when a switch is on)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_... safe for the browser
SUPABASE_SECRET_KEY=                    # sb_secret_... server and seed scripts ONLY, never the browser

# Anthropic (existing)
ANTHROPIC_API_KEY=
